# Base directory for all brains. Each namespace = a subdirectory here.
EVOMEM_ROOT=./vault

# Fallback namespace when the client does not send the X-Evomem-Namespace header.
EVOMEM_DEFAULT_NAMESPACE=default

# Comma-separated Host header allowlist (rmcp DNS-rebinding guard).
# Use "*" to allow any Host. Leave unset for loopback-only (localhost/127.0.0.1/::1).
EVOMEM_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Bind address for the Streamable HTTP MCP endpoint.
BIND=0.0.0.0:8080
